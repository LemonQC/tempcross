.venv/
__pycache__/
*.pyc
.pytest_cache/
results/
*.log
configs/calibration_measured*.json
configs/scenes_measured*.json

# Large raw JSON is preserved losslessly in committed gzip; run regenerates JSON.
evidence/v1/trials.json
evidence/dev_smoke/trials.json
evidence/implementation_interrupted/trials.json

# Version the baseline benchmark's small evidence, not server model/video data.
!results/
results/*
!results/baselines/
results/baselines/*
!results/baselines/**/
!results/baselines/**/*.json
!results/baselines/**/*.jsonl
!results/baselines/**/*.csv
!results/baselines/**/*.md
!results/baselines/**/*.txt
!results/baselines/**/*.svg

# Small evidence for the final 24 mechanism diagnostics.
!results/mechanism/
!results/mechanism/**/
!results/mechanism/**/*.json
!results/mechanism/**/*.csv
!results/mechanism/**/*.md
!results/mechanism/**/*.svg
